PORT=3000
JWT_SECRET=cambia_este_valor_en_produccion
# MongoDB local. Para MongoDB Atlas usar la cadena de conexión que da el panel de Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/cleanstock
# Contraseña del usuario de prueba admin@cleanstock.com. Se usa al crearlo automáticamente
# (si la base no tiene ningún administrador) y en "npm run seed:admin"
ADMIN_INITIAL_PASSWORD=cambiar_esta_clave
# Intentos fallidos de login permitidos por IP cada 15 minutos (opcional, por defecto 10)
LOGIN_RATE_LIMIT=10
